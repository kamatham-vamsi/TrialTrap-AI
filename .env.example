# Required for production
TRIALTRAP_SECRET=replace-with-a-long-random-secret
# Optional database path. For Render persistent disk, point this to the mounted disk.
# DATABASE_PATH=/data/trialtrap.db

# Optional email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WhatsApp alerts through Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
